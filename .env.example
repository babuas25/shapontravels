# Use a dedicated database. Never point tests at production.
DATABASE_URL=postgres://localhost:5432/shapontravels
APP_ENV=local
APP_BIND=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
DB_TIMEOUT_SECONDS=5
# Migration execution is explicit: cargo run -- migrate
# Supplier participation is persisted in PostgreSQL; all start disabled.
FIRSTTRIP_SEARCH_BASE_URL=https://example.invalid
FIRSTTRIP_BASE_URL=https://example.invalid
FIRSTTRIP_EMAIL=
FIRSTTRIP_PASSWORD=
TAKEOFF_SEARCH_BASE_URL=https://example.invalid
TAKEOFF_BASE_URL=https://example.invalid
TAKEOFF_EMAIL=
TAKEOFF_PASSWORD=
TRIPLOVER_SEARCH_BASE_URL=https://example.invalid
TRIPLOVER_BASE_URL=https://example.invalid
TRIPLOVER_EMAIL=
TRIPLOVER_PASSWORD=
# Capabilities are execution gates, not evidence of account entitlement.
FIRSTTRIP_BOOKING_ENABLED=false
FIRSTTRIP_TICKETING_ENABLED=false
TAKEOFF_BOOKING_ENABLED=false
TAKEOFF_TICKETING_ENABLED=false
TRIPLOVER_BOOKING_ENABLED=false
TRIPLOVER_TICKETING_ENABLED=false

# Explicit account currency; user confirmed current three production accounts use BDT.
FIRSTTRIP_CURRENCY=BDT
TAKEOFF_CURRENCY=BDT
TRIPLOVER_CURRENCY=BDT
