# Use a dedicated database. Never point tests at production.
DATABASE_URL=postgres://localhost:5432/shapontravels
APP_ENV=local
APP_BIND=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
DB_TIMEOUT_SECONDS=5
# Exact reverse-proxy peer IPs only; empty means use the socket address.
# For the documented local Nginx: 127.0.0.1,::1; it MUST overwrite X-Real-IP.
AUTH_TRUSTED_PROXY_IPS=
# Per-process Search admission; provisional guardrails, not measured production capacity.
SEARCH_MAX_ACTIVE=4
SEARCH_MAX_QUEUED=8
SEARCH_QUEUE_WAIT_MS=2000
# Proxy/client timeouts must cover queue + supplier + processing; see SEARCH_API.md.
# Migration execution is explicit: cargo run -- migrate
# Supplier participation is persisted in PostgreSQL; all start disabled.
FIRSTTRIP_SEARCH_BASE_URL=https://example.invalid
FIRSTTRIP_BASE_URL=https://example.invalid
FIRSTTRIP_EMAIL=
FIRSTTRIP_PASSWORD=
TAKEOFF_SEARCH_BASE_URL=https://example.invalid
TAKEOFF_BASE_URL=https://example.invalid
TAKEOFF_EMAIL=
TAKEOFF_PASSWORD=
TRIPLOVER_SEARCH_BASE_URL=https://example.invalid
TRIPLOVER_BASE_URL=https://example.invalid
TRIPLOVER_EMAIL=
TRIPLOVER_PASSWORD=
# Capabilities are execution gates, not evidence of account entitlement.
FIRSTTRIP_BOOKING_ENABLED=false
FIRSTTRIP_TICKETING_ENABLED=false
TAKEOFF_BOOKING_ENABLED=false
TAKEOFF_TICKETING_ENABLED=false
TRIPLOVER_BOOKING_ENABLED=false
TRIPLOVER_TICKETING_ENABLED=false

# Explicit account currency; user confirmed current three production accounts use BDT.
FIRSTTRIP_CURRENCY=BDT
TAKEOFF_CURRENCY=BDT
TRIPLOVER_CURRENCY=BDT

# Staged portal identity API. Disabled leaves current portal authority unchanged.
# disabled/staged are safe defaults; canonical requires the complete migration-0046
# rollout pin and external operator evidence described in the runbook.
PORTAL_IDENTITY_MODE=disabled
# Deployment freeze only; does not activate canonical authority. Restart/drain
# every instance together with Next maintenance mode before target review.
# Pauses HTTP business traffic, identity workers and cleanup. Default unchanged.
PORTAL_IDENTITY_MAINTENANCE=false
# Independent 32-byte random base64url secret: stib_ prefix + 43 characters.
PORTAL_IDENTITY_BRIDGE_TOKEN=
# Clerk lookup; writes require the separate disposable-test opt-in below.
PORTAL_IDENTITY_CLERK_SECRET_KEY=
# Temporary bootstrap / read-only preflight credential (stio_) and operator label.
# Remove both after operator work. This credential is not given to Next.
PORTAL_IDENTITY_OPERATOR_TOKEN=
PORTAL_IDENTITY_OPERATOR_ID=
# Phase 4 writers remain disabled. 'test' requires sk_test_ and a loopback
# database whose name ends _identity_test. Live keys cannot enable writes.
PORTAL_IDENTITY_PROVIDER_WRITES=disabled
PORTAL_IDENTITY_APP_ORIGIN=
# Independent webhook-ingest capability; match Next SHAPON_IDENTITY_EVENT_TOKEN.
PORTAL_IDENTITY_EVENT_TOKEN=
# Independent single-attempt mail / wallet notification worker capability (stim_).
# Match Next SHAPON_IDENTITY_MAIL_TOKEN, not the interactive bridge token.
# Mail requires test writers and a loopback Next origin, with disposable SMTP.
PORTAL_IDENTITY_MAIL_TOKEN=
PORTAL_IDENTITY_MAIL_ORIGIN=
# false authenticates notification workers without starting identity email dispatch.
PORTAL_IDENTITY_MAIL_AUTODISPATCH=false

# Phase 6: migration 0045 and dedicated business endpoints are staged only.
# POST /admin/portal-identity/readiness checks schema/bootstrap/recovery counts.
# Canonical mode additionally requires the durable migration-0046 marker and
# complete release/target pin below; defaults remain disabled.
PORTAL_IDENTITY_ROLLOUT_ID=
PORTAL_IDENTITY_TARGET_ID=
PORTAL_IDENTITY_ROLLOUT_REVISION=
PORTAL_IDENTITY_BACKEND_RELEASE=
PORTAL_IDENTITY_FRONTEND_RELEASE=
